# m9: the agent integration (AGENT_INTEGRATION 7.3). build/smoke.ps1 -Script m9 generates clipA.mp4, clipB.mp4 and
# gap.mp4 (6 s, 180 frames each at 30 fps; gap.mp4's tone drops out from 2.25 s to 3.75 s) and starts the app with
# --agent-server --port 47399. The agent calls go over real HTTP through an in-process AgentClient (POST /v1/call).
# JSON arguments write strings in single quotes; a whole argument with spaces goes in double quotes. $name is a value
# saved earlier with save=name=path (dot paths, [n] indexes, [field=value] filters); $dir is this script's folder.

# The user imports the media, saves the project and lets agents write into this folder (Settings > Agents; the run
# restores the settings it started with).
import clipA.mp4 clipB.mp4 gap.mp4
save m9.cutlass
settings page=agents agent-write=. apply
agent-connect name=Smoke
agent-call status {} save=rev0=revision
agent-call media.list {} save=a=result[0].id save=b=result[1].id save=g=result[2].id

# 2. A mutating call without the lock.
agent-call edit.split {'frame':10} expect=lock_required

# 3. Acquire: the banner shows and the editing UI is read-only; the user's keys are swallowed (revision unchanged).
agent-call lock.acquire "{'agentName':'Smoke','reason':'m9 smoke test'}" save=lock=result.lockId
expect-locked holder=Smoke
expect-readonly keys=Ctrl+Z,Delete,Ctrl+K
wait 300
screenshot shots/m9-01-banner.png

# 4. One agent batch: place, split and a title.
agent-call batch.begin {'label':'Assemble'}
agent-call edit.place {'mediaId':'$a','at':0,'mode':'overwrite','streams':'both'}
agent-call edit.place {'mediaId':'$g','at':180,'mode':'overwrite','streams':'both'}
agent-call edit.split {'frame':90}
agent-call project.get {} save=v2=result.tracks[name=V2].id
agent-call edit.title.add "{'trackId':'$v2','at':0,'durationFrames':60,'mode':'overwrite','title':{'text':'Meet Ana'}}"
agent-call batch.end {}
expect-clips 7
expect-duration 360
expect-agent-log batch.end

# The silence in gap.mp4 found through the API and removed as a second batch.
agent-call audio.silences {'start':180,'end':360,'thresholdDb':-40,'minDurationMs':500,'padMs':100} save=s0=result.ranges[0].start save=s1=result.ranges[0].end
agent-call batch.begin "{'label':'Remove silences'}"
agent-call edit.remove-ranges {'ranges':[{'start':$s0,'end':$s1}],'ripple':true}
agent-call batch.end {}
expect-duration-below 360

# 5. A frame rendered through the API, saved as a PNG.
agent-call frame.render {'frame':30,'width':640,'format':'base64'} png=shots/m9-frame30.png

# 6. Pause: a mutating call waits (1 s in smoke runs) and fails with paused; reads still work. Then resume.
agent-pause
expect-locked holder=Smoke paused
agent-call edit.split {'frame':20} expect=paused
agent-call project.describe {}
agent-resume
expect-locked holder=Smoke
expect-agent-log edit.split code=paused

# 7. Take over: the next call gets lock_lost; one Ctrl+Z reverts the whole "Remove silences" batch.
agent-takeover
expect-unlocked
agent-call edit.split {'frame':20} expect=lock_lost
key Ctrl+Z edit
expect-duration 360
expect-clips 7
wait 300
screenshot shots/m9-02-after-undo.png

# 8. Acquire again, export through the API, check it with ffprobe, release.
agent-call lock.acquire "{'agentName':'Smoke','reason':'export'}" save=lock=result.lockId
agent-call exports.start "{'preset':'h264','quality':'draft','range':'whole','outputPath':'$dir/m9-export.mp4','overwrite':true}" save=exp=result.id
agent-call exports.get {'exportId':'$exp','waitMs':20000} until=result.state=completed timeout=300
probe m9-export.mp4 vcodec=h264 frames=360
agent-call lock.release {}
expect-unlocked

# 9. The write gate never fired, and the Agent panel shows the calls.
expect-no-refused
panel agent
wait 300
screenshot shots/m9-03-panel.png
panel media
show-dialog settings page=agents screenshot=shots/m9-04-settings-agents.png

# 10. The Agent menu (AGENT_INTEGRATION 6.6 and 9.4): the plain briefing (no client registered yet: the generic tail)
# and the HTTP only one fill every placeholder and name the project and the tool steps (the smoke dialog service
# confirms the token for the HTTP only one; the saved copy masks it); Stop and Start through the menu command switch
# the server, the badge and the menu text (the first-start dialog answers Start with "Register with: none");
# screenshots of the panel header, the open Agent menu and the first-start dialog.
agent-briefing save=shots/m9-briefing.txt
agent-briefing http save=shots/m9-briefing-http.txt
panel agent
wait 1500
screenshot shots/m9-05-panel-header.png
show-menu Agent screenshot=shots/m9-06-agent-menu.png
menu-stop-mcp
wait 300
screenshot shots/m9-07-mcp-off.png
menu-start-mcp
wait 300
screenshot shots/m9-08-mcp-ready.png
show-dialog mcp-start screenshot=shots/m9-09-mcp-start-dialog.png
panel media

# 11. Agent clients (AGENT_INTEGRATION 9.3 and 9.4). A smoke run's client registry is always a sandbox: a fake home
# and a client CLI runner that starts nothing, so no real client configuration is read or written. agent-home gives it
# an empty fake home in this folder; write-file seeds a detected client (.cursor), a stale entry (.gemini), a TOML file
# with another table (.codex) and a foreign entry (Claude Desktop, in the fake per-user configuration folder).
settings agent-home=clients-home
write-file $clienthome/.cursor/mcp.json "{'mcpServers':{'other':{'command':'npx','args':['thing']}}}" json
write-file $clienthome/.gemini/settings.json "{'theme':'Dark','mcpServers':{'cutlass':{'command':'C:/old/Cutlass.Agent.Mcp.exe','args':[]}}}" json
write-file $clienthome/.codex/config.toml "model = 'o3'\n\n[mcp_servers.other]\ncommand = 'npx'\n"
write-file $clientconfig/Claude/claude_desktop_config.json "{'mcpServers':{'cutlass':{'command':'npx','args':['another-server']}}}" json
agent-clients expect=cursor:not-registered,gemini-cli:stale,codex-cli:not-registered,claude-desktop:foreign,claude-code:not-installed,windsurf:not-installed current=0
agent-client cursor register expect=current
agent-client codex-cli register expect=current
agent-client gemini-cli update expect=current
agent-clients current=3
# The plain briefing now renders for the client registered last; a "Copy briefing for" item for any profile.
agent-briefing save=shots/m9-briefing-last-client.txt
agent-briefing target=claude-code save=shots/m9-briefing-cli-client.txt
agent-briefing target=openai-compatible save=shots/m9-briefing-harness.txt
# The open "Copy briefing for" submenu: one item per profile, the last one HTTP only (DESIGN 8).
show-menu Agent submenu="Copy briefing for" screenshot=shots/m9-14-briefing-submenu.png
show-dialog connect-clients screenshot=shots/m9-10-connect-clients.png
show-dialog settings page=agents height=1500 screenshot=shots/m9-12-settings-connect-clients.png
panel agent
wait 800
screenshot shots/m9-13-panel-clients.png
agent-client cursor remove expect=not-registered
agent-clients current=2
# With Cursor unregistered the first-start dialog picks it in "Register with" and shows the entry it would write.
show-dialog mcp-start screenshot=shots/m9-11-mcp-start-clients.png
panel media
