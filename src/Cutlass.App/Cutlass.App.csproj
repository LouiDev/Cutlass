<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cutlass.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/cutlass.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cutlass.Core\Cutlass.Core.csproj" />
    <ProjectReference Include="..\Cutlass.Compiler\Cutlass.Compiler.csproj" />
    <ProjectReference Include="..\Cutlass.Media\Cutlass.Media.csproj" />
    <!-- AGENT_INTEGRATION 2.1: the App hosts the agent API (AppAgentHost, AgentServerController). -->
    <ProjectReference Include="..\Cutlass.Agent\Cutlass.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Inter TTFs and OFL.txt for drawtext; copied to <cache>/work/ by the work directory (TECH_BRIEF 5.5). -->
    <Content Include="Assets/Fonts/*" CopyToOutputDirectory="PreserveNewest" Link="fonts/%(Filename)%(Extension)" />
    <!-- The window icon (DESIGN 8); the same file is the exe icon above. -->
    <AvaloniaResource Include="Assets/cutlass.ico" />
    <!-- AGENT_INTEGRATION 6.6: the default agent briefing templates (a user copy in <data>/agent/ replaces them). -->
    <EmbeddedResource Include="Services/Agent/Briefing/*.md" LogicalName="Cutlass.App.Services.Agent.Briefing.%(Filename)%(Extension)" />
    <!-- AGENT_INTEGRATION 9.3: the agent client profiles, copied beside the exe (users may edit or override them) and
         embedded as the fallback when the file is missing. -->
    <Content Include="Assets/agent-clients.json" CopyToOutputDirectory="PreserveNewest" Link="agent-clients.json" />
    <EmbeddedResource Include="Assets/agent-clients.json" LogicalName="Cutlass.App.Assets.agent-clients.json" />
  </ItemGroup>

</Project>
