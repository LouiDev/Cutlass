  <StreamGeometry x:Key="IconSearch">F0 M3,10 A7,7 0 1 1 17,10 A7,7 0 1 1 3,10 Z M5,10 A5,5 0 1 0 15,10 A5,5 0 1 0 5,10 Z M15.2,16.6 L16.6,15.2 L21.5,20.1 L20.1,21.5 Z</StreamGeometry>
