<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Monochrome icon geometries for PathIcon (DESIGN 8: no icon packages). All are drawn as filled shapes on a
    24x24 grid. "F0" selects the even-odd fill rule for shapes with holes.
  -->

  <!-- Transport -->
  <StreamGeometry x:Key="IconPlay">M7,4 L20,12 L7,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStepBack">M6,5 H8 V19 H6 Z M19,5 L9,12 L19,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStepForward">M16,5 H18 V19 H16 Z M5,5 L15,12 L5,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGoToIn">M4,4 H9 V6 H6 V18 H9 V20 H4 Z M20,6 L11,12 L20,18 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGoToOut">M20,4 H15 V6 H18 V18 H15 V20 H20 Z M4,6 L13,12 L4,18 Z</StreamGeometry>
  <StreamGeometry x:Key="IconLoop">M4,11 A6,6 0 0 1 10,5 H16 V2 L21,6.5 L16,11 V8 H10 A3,3 0 0 0 7,11 Z M20,13 A6,6 0 0 1 14,19 H8 V22 L3,17.5 L8,13 V16 H14 A3,3 0 0 0 17,13 Z</StreamGeometry>

  <!-- Tools (V B N Y C) -->
  <StreamGeometry x:Key="IconSelect">M5,3 L19,13 L12.5,13.8 L16,21 L13,22.3 L9.6,15 L5,19 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRipple">M5,4 H8 V20 H5 Z M10,10.5 H16 V7 L21,12 L16,17 V13.5 H10 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRoll">M11,4 H13 V20 H11 Z M2,12 L7,8 V11 H9.5 V13 H7 V16 Z M22,12 L17,8 V11 H14.5 V13 H17 V16 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSlip">M2,6 H4 V18 H2 Z M20,6 H22 V18 H20 Z M6,12 L10,8 V11 H14 V8 L18,12 L14,16 V13 H10 V16 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRazor">F0 M3,7 H21 V17 H3 Z M7,11 H17 V13 H7 Z M10,3 H14 V7 H10 Z M10,17 H14 V21 H10 Z</StreamGeometry>

  <!-- Timeline toolbar -->
  <StreamGeometry x:Key="IconZoomIn">F0 M3,10 A7,7 0 1 1 17,10 A7,7 0 1 1 3,10 Z M5,10 A5,5 0 1 0 15,10 A5,5 0 1 0 5,10 Z M9,7 H11 V9 H13 V11 H11 V13 H9 V11 H7 V9 H9 Z M15.2,16.6 L16.6,15.2 L21.5,20.1 L20.1,21.5 Z</StreamGeometry>
