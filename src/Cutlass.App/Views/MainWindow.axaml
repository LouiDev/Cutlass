<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cutlass.App.ViewModels"
        xmlns:views="using:Cutlass.App.Views"
        xmlns:conv="using:Cutlass.App.Converters"
        xmlns:controls="using:Cutlass.App.Controls"
        xmlns:services="using:Cutlass.App.Services"
        xmlns:servicescommands="using:Cutlass.App.Services.Commands"
        xmlns:viewsagent="using:Cutlass.App.Views.Agent"
        xmlns:viewsinspector="using:Cutlass.App.Views.Inspector"
        xmlns:vmagent="using:Cutlass.App.ViewModels.Agent"
        xmlns:vmtimeline="using:Cutlass.App.ViewModels.Timeline"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="Cutlass.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1600" Height="900"
        MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

  <Panel>
    <!-- DESIGN 3: menu row, top panels (58%), timeline (42%), status bar. Every boundary is a GridSplitter. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,58*,4,42*,Auto">

      <!-- Menu row: menus, project name with * when dirty, Export as the primary button; under it the agent banner. -->
      <DockPanel Grid.Row="0">
      <!-- AGENT_INTEGRATION 6.2: the lock banner across the window under the menu row. -->
      <viewsagent:AgentBanner DockPanel.Dock="Bottom" DataContext="{Binding Agent}" IsVisible="{Binding IsBannerVisible}" />
      <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource ToolbarHeight}"
            Background="{DynamicResource Bg0Brush}">
        <Menu Grid.Column="0">
          <MenuItem Header="_File">
            <MenuItem Header="_New" InputGesture="Ctrl+N" Command="{Binding NewCommand}" />
            <MenuItem Header="_Open..." InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
            <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
            <Separator />
            <MenuItem Header="_Import..." InputGesture="Ctrl+I" Command="{Binding ImportCommand}" />
            <MenuItem Header="_Relink media..." Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RelinkMedia}" />
            <MenuItem Header="_Export..." InputGesture="Ctrl+E" Command="{Binding ExportCommand}" />
            <Separator />
            <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Command="{Binding QuitCommand}" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="{Binding UndoMenuText}" InputGesture="Ctrl+Z" Command="{Binding Timeline.UndoCommand}" />
            <MenuItem Header="{Binding RedoMenuText}" InputGesture="Ctrl+Shift+Z" Command="{Binding Timeline.RedoCommand}" />
            <Separator />
            <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Cut}" />
            <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Copy}" />
            <MenuItem Header="_Paste" InputGesture="Ctrl+V" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Paste}" />
            <MenuItem Header="Paste _Insert" InputGesture="Ctrl+Shift+V" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.PasteInsert}" />
            <Separator />
            <MenuItem Header="_Delete" InputGesture="Delete" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Lift}" />
            <MenuItem Header="Ripple D_elete" InputGesture="Shift+Delete" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RippleDelete}" />
            <Separator />
            <MenuItem Header="Select _All" InputGesture="Ctrl+A" Command="{Binding Timeline.SelectAllCommand}" />
            <MenuItem Header="Deselect" InputGesture="Escape" Command="{Binding Timeline.ClearSelectionCommand}" />
            <Separator />
            <MenuItem Header="Se_ttings..." InputGesture="Ctrl+OemComma" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Settings}" />
          </MenuItem>
          <MenuItem Header="_Clip">
            <MenuItem Header="_Insert from Source" InputGesture="OemComma" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Insert}" />
            <MenuItem Header="_Overwrite from Source" InputGesture="OemPeriod" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Overwrite}" />
            <MenuItem Header="_Match Frame" InputGesture="F" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.MatchFrame}" />
            <Separator />
            <MenuItem Header="_Split at Playhead" InputGesture="Ctrl+K" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Split}" />
            <MenuItem Header="Split _All Tracks" InputGesture="Ctrl+Shift+K" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.SplitAll}" />
            <MenuItem Header="Trim Start to Playhead" InputGesture="Q" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RippleTrimStart}" />
            <MenuItem Header="Trim End to Playhead" InputGesture="W" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RippleTrimEnd}" />
            <Separator />
            <MenuItem Header="Add Default _Transition" InputGesture="Ctrl+D" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddTransition}" />
            <MenuItem Header="Add Audio _Crossfade" InputGesture="Ctrl+Shift+D" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddAudioCrossfade}" />
            <MenuItem Header="New T_itle" InputGesture="Ctrl+T" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.NewTitle}" />
            <Separator />
            <MenuItem Header="Sp_eed..." InputGesture="Ctrl+R" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.Speed}" />
            <MenuItem Header="_Link / Unlink" InputGesture="Ctrl+L" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.LinkUnlink}" />
            <MenuItem Header="Move into S_ync" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.MoveIntoSync}" />
            <MenuItem Header="_Enable / Disable" InputGesture="Shift+E" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ToggleEnabled}" />
            <MenuItem Header="Nudge Left" InputGesture="Alt+Left" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.NudgeLeft}" />
            <MenuItem Header="Nudge Right" InputGesture="Alt+Right" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.NudgeRight}" />
          </MenuItem>
          <MenuItem Header="_Sequence">
            <MenuItem Header="Mark _In" InputGesture="I" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.MarkIn}" />
            <MenuItem Header="Mark _Out" InputGesture="O" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.MarkOut}" />
            <MenuItem Header="Mark Cli_p" InputGesture="X" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.MarkClip}" />
            <MenuItem Header="_Clear In and Out" InputGesture="Ctrl+Shift+X" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ClearInOut}" />
            <MenuItem Header="Go to In" InputGesture="Shift+I" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.GoToIn}" />
            <MenuItem Header="Go to Out" InputGesture="Shift+O" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.GoToOut}" />
            <MenuItem Header="Select In to Out" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.SelectInOutRange}" />
            <MenuItem Header="Ripple Delete In to Out" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RippleDeleteInOutRange}" />
            <Separator />
            <MenuItem Header="Add _Marker" InputGesture="M" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddMarker}" />
            <MenuItem Header="Next Marker" InputGesture="Shift+M" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.NextMarker}" />
            <MenuItem Header="Previous Marker" InputGesture="Ctrl+Shift+M" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.PreviousMarker}" />
            <Separator />
            <MenuItem Header="Add _Video Track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddVideoTrack}" />
            <MenuItem Header="Add _Audio Track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddAudioTrack}" />
            <MenuItem Header="_Remove Selected Track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RemoveSelectedTrack}" />
            <MenuItem Header="Close _Gap" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.CloseGap}" />
            <Separator />
            <MenuItem Header="Sequence _Settings..." Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.SequenceSettings}" />
          </MenuItem>
          <!-- AGENT_INTEGRATION 6.6 and 9.4: the Agent menu between Sequence and View. "Copy briefing for" lists one item per
               client profile (the plain HTTP one last); the plain item renders for the client registered last. -->
          <MenuItem Header="_Agent">
            <MenuItem Header="{Binding Agent.ServerMenuText}" InputGesture="F9" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AgentToggleServer}" />
            <Separator />
            <MenuItem Header="_Copy briefing for your agent" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AgentCopyBriefing}" />
            <MenuItem Header="Copy _briefing for" ItemsSource="{Binding BriefingTargets}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vmagent:BriefingTargetItem">
                  <Setter Property="Header" Value="{Binding Header}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                  <Setter Property="CommandParameter" Value="{Binding CommandId}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <Separator />
            <MenuItem Header="C_onnect an agent client..." Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AgentConnectClients}" />
            <Separator />
            <MenuItem Header="Agent _panel" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ShowAgentPanel}" />
            <MenuItem Header="_Take over" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AgentTakeOver}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="_Timeline Monitor" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ShowTimelineMonitor}" />
            <MenuItem Header="_Source Monitor" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ShowSourceMonitor}" />
            <Separator />
            <MenuItem Header="Play / Pause" InputGesture="Space" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.PlayPause}" />
            <MenuItem Header="Play In to Out" InputGesture="Shift+Space" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.PlayInToOut}" />
            <MenuItem Header="_Loop" InputGesture="Ctrl+Shift+L" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.ToggleLoop}" />
            <Separator />
            <MenuItem Header="Zoom _In" InputGesture="OemPlus" Command="{Binding Timeline.ZoomInCommand}" />
            <MenuItem Header="Zoom _Out" InputGesture="OemMinus" Command="{Binding Timeline.ZoomOutCommand}" />
            <MenuItem Header="Zoom to _Fit" InputGesture="Shift+Z" Command="{Binding Timeline.ZoomToFitCommand}" />
            <Separator />
            <MenuItem Header="Safe _Guides" InputGesture="G" Command="{Binding Viewer.ToggleGuidesCommand}" />
            <MenuItem Header="Use _Proxies" InputGesture="P" Command="{Binding Viewer.ToggleProxiesCommand}" />
            <Separator />
            <MenuItem Header="_Jobs" Command="{Binding Jobs.ToggleCommand}" />
            <Separator />
            <MenuItem Header="Agent: _Pause / Resume" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AgentPauseResume}" />
            <MenuItem Header="Agent: _Follow" ToggleType="CheckBox" IsChecked="{Binding Agent.Follow}" />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="_Locate ffmpeg..." Command="{Binding LocateFfmpegCommand}" />
            <MenuItem Header="Open _Log Folder" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.OpenLogFolder}" />
            <Separator />
            <MenuItem Header="_About Cutlass" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.About}" />
          </MenuItem>
        </Menu>
        <TextBlock Grid.Column="1" Text="{Binding TitleText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Classes="secondary" IsVisible="{Binding HasProject}" />
        <Button Grid.Column="2" Classes="accent" Margin="8,0" Command="{Binding ExportCommand}" ToolTip.Tip="Export (Ctrl+E)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" />
            <TextBlock Text="Export" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      </DockPanel>

      <!-- Top row: Media 22% | Viewer 56% | Inspector 22% -->
      <Grid x:Name="TopGrid" Grid.Row="1" ColumnDefinitions="22*,4,56*,4,22*">
        <views:MediaBinView Grid.Column="0" MinWidth="200" DataContext="{Binding MediaBin}" />
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
        <views:ViewerView Grid.Column="2" MinWidth="360" DataContext="{Binding Viewer}" />
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
        <viewsinspector:InspectorView Grid.Column="4" MinWidth="220" DataContext="{Binding Inspector}" />
      </Grid>

      <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

      <!-- Timeline panel -->
      <Border x:Name="TimelinePanel" Grid.Row="3" Classes="panel" MinHeight="200">
        <DockPanel>
          <!-- Toolbar (30 px): tools, snap, linked selection, playhead timecode, zoom, + Track. -->
          <Border DockPanel.Dock="Top" Classes="header" Padding="4,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="icon"
                        Classes.active="{Binding Timeline.Tool, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static vmtimeline:EditTool.Select}}"
                        Command="{Binding Timeline.SelectToolCommand}" CommandParameter="{x:Static vmtimeline:EditTool.Select}"
                        ToolTip.Tip="Select (V)">
                  <PathIcon Data="{StaticResource IconSelect}" />
                </Button>
                <Button Classes="icon"
                        Classes.active="{Binding Timeline.Tool, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static vmtimeline:EditTool.Ripple}}"
                        Command="{Binding Timeline.SelectToolCommand}" CommandParameter="{x:Static vmtimeline:EditTool.Ripple}"
                        ToolTip.Tip="Ripple (B)">
                  <PathIcon Data="{StaticResource IconRipple}" />
                </Button>
                <Button Classes="icon"
                        Classes.active="{Binding Timeline.Tool, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static vmtimeline:EditTool.Roll}}"
                        Command="{Binding Timeline.SelectToolCommand}" CommandParameter="{x:Static vmtimeline:EditTool.Roll}"
                        ToolTip.Tip="Roll (N)">
                  <PathIcon Data="{StaticResource IconRoll}" />
                </Button>
                <Button Classes="icon"
                        Classes.active="{Binding Timeline.Tool, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static vmtimeline:EditTool.Slip}}"
                        Command="{Binding Timeline.SelectToolCommand}" CommandParameter="{x:Static vmtimeline:EditTool.Slip}"
                        ToolTip.Tip="Slip (Y)">
                  <PathIcon Data="{StaticResource IconSlip}" />
                </Button>
                <Button Classes="icon"
                        Classes.active="{Binding Timeline.Tool, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static vmtimeline:EditTool.Razor}}"
                        Command="{Binding Timeline.SelectToolCommand}" CommandParameter="{x:Static vmtimeline:EditTool.Razor}"
                        ToolTip.Tip="Razor (C)">
                  <PathIcon Data="{StaticResource IconRazor}" />
                </Button>
                <Rectangle Classes="separator" />
                <Button Classes="icon" Classes.active="{Binding Timeline.SnapEnabled}"
                        Command="{Binding Timeline.ToggleSnapCommand}" ToolTip.Tip="Snapping (S)">
                  <PathIcon Data="{StaticResource IconSnap}" />
                </Button>
                <Button Classes="icon" Classes.active="{Binding Timeline.LinkedSelection}"
                        Command="{Binding Timeline.ToggleLinkedSelectionCommand}" ToolTip.Tip="Linked selection">
                  <PathIcon Data="{StaticResource IconLink}" />
                </Button>
                <Rectangle Classes="separator" />
                <TextBox x:Name="PlayheadBox" Classes="timecodeBox" Text="{Binding PlayheadText}" Width="104"
                         ToolTip.Tip="Playhead: type a timecode or +N / -N frames, then Enter">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding CommitPlayheadTextCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </StackPanel>
              <Button DockPanel.Dock="Right" Height="24" Padding="8,0" VerticalAlignment="Center"
                      VerticalContentAlignment="Center" ToolTip.Tip="Add or delete tracks" IsEnabled="{Binding CanEditProject}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" />
                  <TextBlock Text="Track" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Add video track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddVideoTrack}" />
                    <MenuItem Header="Add audio track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.AddAudioTrack}" />
                    <Separator />
                    <MenuItem Header="Delete selected track" Command="{Binding RunCommandCommand}" CommandParameter="{x:Static servicescommands:CommandIds.RemoveSelectedTrack}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <Button Classes="icon" Command="{Binding Timeline.ZoomOutCommand}" ToolTip.Tip="Zoom out (-)">
                  <PathIcon Data="{StaticResource IconZoomOut}" />
                </Button>
                <Slider Width="180" Minimum="0" Maximum="100" Value="{Binding Timeline.ZoomLevel}" VerticalAlignment="Center"
                        ToolTip.Tip="Zoom" Focusable="False" />
                <Button Classes="icon" Command="{Binding Timeline.ZoomInCommand}" ToolTip.Tip="Zoom in (+)">
                  <PathIcon Data="{StaticResource IconZoomIn}" />
                </Button>
                <Button Classes="icon" Command="{Binding Timeline.ZoomToFitCommand}" ToolTip.Tip="Zoom to fit (Shift+Z)">
                  <PathIcon Data="{StaticResource IconGrid}" />
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- DESIGN 4.5: the stereo master peak meter at the timeline's right edge. -->
          <Border DockPanel.Dock="Right" Width="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                  ToolTip.Tip="Master peak meter (dBFS)">
            <controls:AudioMeter LeftDb="{Binding Viewer.MeterLeftDb}" RightDb="{Binding Viewer.MeterRightDb}"
                                 LeftPeakDb="{Binding Viewer.MeterLeftPeakDb}" RightPeakDb="{Binding Viewer.MeterRightPeakDb}" />
          </Border>
          <views:TimelineView DataContext="{Binding Timeline}" />
        </DockPanel>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="4" Classes="statusBar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding SequenceFormatText}" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Classes="statusDot"
                     Classes.ok="{Binding IsFfmpegOk}" Classes.error="{Binding IsFfmpegError}" />
            <TextBlock Text="{Binding FfmpegStatusText}" ToolTip.Tip="{Binding FfmpegToolTip}" />
            <Button Classes="link" Content="Locate..." Margin="6,0,0,0" IsVisible="{Binding IsFfmpegError}"
                    Command="{Binding LocateFfmpegCommand}" ToolTip.Tip="Locate ffmpeg" />
            <Button Classes="link" Content="Settings..." Margin="6,0,0,0" IsVisible="{Binding IsFfmpegError}"
                    Command="{Binding OpenFfmpegSettingsCommand}" ToolTip.Tip="ffmpeg location in Settings (Media)" />
            <Rectangle Classes="separator" />
            <Button x:Name="JobsButton" Classes="link" Content="{Binding Jobs.Summary}" ToolTip.Tip="Show jobs"
                    Command="{Binding Jobs.ToggleCommand}" />
            <!-- AGENT_INTEGRATION 6.6: the MCP badge after the jobs ("MCP off", "MCP ready", "MCP: <agent>",
                 "MCP: port in use"); a click opens the AGENT tab, or Settings > Agents while the server failed. -->
            <Rectangle Classes="separator" />
            <Button Classes="link" Command="{Binding Agent.BadgeClickCommand}" ToolTip.Tip="{Binding Agent.BadgeToolTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="statusDot"
                         Classes.ok="{Binding Agent.BadgeIsOk}" Classes.accent="{Binding Agent.BadgeIsAccent}"
                         Classes.amber="{Binding Agent.BadgeIsAmber}" Classes.warning="{Binding Agent.BadgeIsWarning}"
                         Classes.error="{Binding Agent.BadgeIsDanger}" />
                <TextBlock Text="{Binding Agent.BadgeText}" Classes.danger="{Binding Agent.BadgeIsDanger}" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Agent.PendingText}" Margin="8,0,0,0"
                       IsVisible="{Binding Agent.PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Rectangle Classes="separator" />
            <TextBlock Text="{Binding CacheSummary}" />
            <Rectangle Classes="separator" IsVisible="{Binding IsAudioUnavailable}" />
            <TextBlock Text="Audio unavailable" Foreground="{DynamicResource WarningBrush}"
                       IsVisible="{Binding IsAudioUnavailable}" ToolTip.Tip="{Binding AudioToolTip}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Welcome overlay: covers the panels (rows 1 to 3) while no project is open. The menu row with the agent
           banner and the status bar stay visible and usable, so Take over, Pause and the ask-first Allow and Deny
           are never hidden under it. While an agent holds the project the welcome actions are disabled. -->
      <Panel Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding ShowWelcome}" IsEnabled="{Binding !Agent.IsLocked}">
        <views:WelcomeOverlay DataContext="{Binding Welcome}" />
      </Panel>
    </Grid>

    <!-- Jobs popover, anchored to the status bar job summary. -->
    <Popup PlacementTarget="{Binding #JobsButton}" Placement="TopEdgeAlignedLeft" VerticalOffset="-4"
           IsOpen="{Binding Jobs.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
      <Border Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="4" Padding="12">
        <views:JobsPopover DataContext="{Binding Jobs}" />
      </Border>
    </Popup>

    <!-- Toast -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Padding="14,8" CornerRadius="4"
            Background="{DynamicResource Bg3Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            IsVisible="{Binding IsToastVisible}" IsHitTestVisible="False" MaxWidth="720">
      <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" />
    </Border>
  </Panel>
</Window>
