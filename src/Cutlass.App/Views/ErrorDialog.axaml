<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cutlass.App.ViewModels"
        x:Class="Cutlass.App.Views.ErrorDialog"
        x:DataType="vm:ErrorDialogViewModel"
        Title="{Binding Title}"
        Width="640" Height="460" MinWidth="420" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- DESIGN 9: summary, the last 30 ffmpeg log lines and Copy details (which includes the command). -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Copy details" Click="OnCopyClick" />
      <Button Classes="accent" Content="Close" IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasCommand}" Spacing="4" Margin="0,8,0,0">
      <TextBlock Classes="panelTitle" Text="COMMAND" />
      <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72"
               FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="11" />
    </StackPanel>
    <DockPanel IsVisible="{Binding HasLog}">
      <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="FFMPEG LOG" Margin="0,0,0,4" />
      <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="11"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>
  </DockPanel>
</Window>
