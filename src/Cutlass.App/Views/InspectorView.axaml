<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cutlass.App.ViewModels"
             xmlns:insp="using:Cutlass.App.Views.Inspector"
             x:Class="Cutlass.App.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">

  <!-- Every section view model (clip, title, transition, gap, sequence) renders with the shared section view. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:InspectorSection">
      <insp:InspectorSectionView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- DESIGN 4.4: context sensitive, collapsible sections whose state is remembered. -->
  <Border Classes="panel">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="header">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="panelTitle" Text="{Binding Header}" />
          <TextBlock Classes="panelTitle active" Text="INSPECTOR" />
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- AGENT_INTEGRATION 3.7: read-only while an agent holds the project; the values keep updating. -->
        <ContentControl Content="{Binding Section}" Margin="10,6,10,12" IsEnabled="{Binding !IsReadOnly}" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
