<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cutlass.App.ViewModels"
        xmlns:vmdialogs="using:Cutlass.App.ViewModels.Dialogs"
        x:Class="Cutlass.App.Views.Dialogs.RelinkDialog"
        x:DataType="vmdialogs:RelinkDialogViewModel"
        Title="Relink media"
        Width="720" Height="420" MinWidth="520" MinHeight="260"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- DESIGN 11: offline (and changed) media with Locate... per item and Search folder... for all of them. -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="These media files are missing or changed. Locate each file, or search a folder: files are matched by name, then by name without extension, then by size and content." />
    <!-- DESIGN 11: remote paths the open scan did not touch. -->
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource WarningBrush}"
               IsVisible="{Binding HasUnconfirmed}"
               Text="Files on a network location were not checked when the project opened, so no credentials were sent to that server. Confirm a location you trust to look the file up." />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="Relink" IsDefault="True" Command="{Binding RelinkCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Search folder..." Command="{Binding SearchFolderCommand}" />
        <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
      </StackPanel>
    </DockPanel>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vmdialogs:RelinkItemViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="2,3">
              <StackPanel Grid.Column="0" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding IsOffline}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding OldPath}" FontSize="10" Classes="secondary" TextTrimming="PrefixCharacterEllipsis"
                           ToolTip.Tip="{Binding OldPath}" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="PrefixCharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{Binding StatusText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="Confirm location" IsVisible="{Binding IsUnconfirmed}"
                        ToolTip.Tip="Look the file up at its recorded network location"
                        Command="{Binding $parent[Window].((vmdialogs:RelinkDialogViewModel)DataContext).ConfirmLocationCommand}"
                        CommandParameter="{Binding}" />
                <Button Content="Locate..."
                        Command="{Binding $parent[Window].((vmdialogs:RelinkDialogViewModel)DataContext).LocateCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
