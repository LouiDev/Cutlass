<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cutlass.App.ViewModels"
        xmlns:vmdialogs="using:Cutlass.App.ViewModels.Dialogs"
        x:Class="Cutlass.App.Views.Dialogs.ExportDialog"
        x:DataType="vmdialogs:ExportDialogViewModel"
        Title="Export"
        Width="600" SizeToContent="Height" MinWidth="480"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
  </Window.Styles>

  <!-- DESIGN 9: preset (greyed with a reason), quality, resolution, range, output path, limit peaks, command. -->
  <StackPanel Margin="20" Spacing="12">
    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Grid.Row="0" Classes="label" Text="Preset" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
        <ComboBox.Styles>
          <Style Selector="ComboBoxItem" x:DataType="vmdialogs:ExportPresetOption">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
          </Style>
        </ComboBox.Styles>
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vmdialogs:ExportPresetOption">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding DisplayName}" />
              <TextBlock Text="{Binding UnavailableReason}" Classes="hint" FontSize="11"
                         IsVisible="{Binding !IsAvailable}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" Classes="label" Text="Quality" />
      <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="160" ItemsSource="{Binding Qualities}"
                SelectedItem="{Binding SelectedQuality}" IsEnabled="{Binding IsQualityEnabled}"
                ToolTip.Tip="Fixed for this preset when disabled" />

      <TextBlock Grid.Row="2" Classes="label" Text="Resolution" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ComboBox MinWidth="220" ItemsSource="{Binding Resolutions}"
                  SelectedItem="{Binding SelectedResolution}" IsEnabled="{Binding HasResolution}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vmdialogs:ExportResolutionOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- DESIGN 9: custom is an even height with the sequence aspect locked. -->
        <TextBox Width="80" Text="{Binding CustomHeightText}" IsVisible="{Binding IsCustomResolution}"
                 ToolTip.Tip="Output height in pixels (rounded down to even)" />
        <TextBlock VerticalAlignment="Center" Text="{Binding CustomSizeText}" IsVisible="{Binding IsCustomResolution}" />
      </StackPanel>

      <TextBlock Grid.Row="3" Classes="label" Text="Range" VerticalAlignment="Top" Margin="0,6,16,0" />
      <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="range" Content="Whole sequence" IsChecked="{Binding IsWholeRange}" />
          <RadioButton GroupName="range" Content="In to Out" IsChecked="{Binding IsInOutRange}"
                       IsEnabled="{Binding HasInOut}" ToolTip.Tip="Set In (I) and Out (O) on the timeline first" />
        </StackPanel>
        <TextBlock Classes="secondary timecode" FontWeight="Normal" FontSize="11" Text="{Binding RangeText}" />
      </StackPanel>

      <TextBlock Grid.Row="4" Classes="label" Text="Output" />
      <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Grid.Column="0" Text="{Binding OutputPath}" />
        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" />
      </Grid>

      <TextBlock Grid.Row="5" Classes="label" Text="Audio" />
      <CheckBox Grid.Row="5" Grid.Column="1" Content="Limit peaks" IsChecked="{Binding LimitPeaks}"
                ToolTip.Tip="Run the mix through a limiter so it never clips" />

      <TextBlock Grid.Row="6" Classes="label" Text="Estimated size" />
      <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding EstimatedSizeText}" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Show ffmpeg command" Command="{Binding ShowCommandCommand}" />
        <Button Content="Copy" Command="{Binding CopyCommandCommand}" IsVisible="{Binding CommandText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <TextBox Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
               FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="11"
               IsVisible="{Binding CommandText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <DockPanel Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="Export" IsDefault="True" Command="{Binding ExportCommand}" />
      </StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ExportErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
