<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cutlass.App.ViewModels"
             x:Class="Cutlass.App.Views.AgentPanelView"
             x:DataType="vm:AgentViewModel">

  <!--
    AGENT_INTEGRATION 6.3: the AGENT tab of the left panel. A lock card (phase, agent, reason, lease left, Pause/Resume,
    Take over), a connection card (address, token Copy, Claude Code command Copy), the call log newest first (time,
    agent, tool, duration, code in Danger for errors, the arguments as a tooltip), and Open agent docs / Open log folder.
  -->
  <DockPanel Margin="8,8,8,6">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <Border Classes="agentCard">
        <StackPanel Spacing="4">
          <TextBlock Classes="panelTitle" Text="LOCK" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="statusDot"
                     Classes.accent="{Binding BadgeIsAccent}" Classes.amber="{Binding BadgeIsAmber}" />
            <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Classes="secondary" Text="{Binding HeadlineText}" TextWrapping="Wrap"
                     IsVisible="{Binding IsLocked}" />
          <TextBlock Classes="secondary agentClock" Text="{Binding LeaseText}"
                     IsVisible="{Binding LeaseText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsLocked}">
            <Button Classes="agentSecondary" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" />
            <Button Classes="accent" Content="Take over" Command="{Binding TakeOverCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="agentCard">
        <StackPanel Spacing="4">
          <TextBlock Classes="panelTitle" Text="CONNECTION" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="statusDot" Classes.ok="{Binding IsServerListening}" />
            <SelectableTextBlock Text="{Binding ServerText}" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Classes="agentSecondary" Content="Copy token" Command="{Binding CopyTokenCommand}" Margin="0,0,6,6"
                    ToolTip.Tip="The bearer token agents send (never shown in full)" />
            <Button Classes="agentSecondary" Content="Copy Claude Code command" Command="{Binding CopyClaudeCommandCommand}" Margin="0,0,6,6"
                    ToolTip.Tip="claude mcp add cutlass -- (the MCP server next to Cutlass)" />
          </WrapPanel>
          <TextBlock Classes="secondary" Text="{Binding PanelNote}" FontSize="11"
                     IsVisible="{Binding PanelNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="panelTitle" Text="CALLS" Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
      <Button Classes="link" Content="Open agent docs" Command="{Binding OpenDocsCommand}" />
      <Button Classes="link" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
    </StackPanel>

    <Panel>
      <TextBlock Classes="hint" Text="No agent calls yet." IsVisible="{Binding !HasCalls}" />
      <ListBox Classes="agentCalls" ItemsSource="{Binding Calls}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentCallItemViewModel">
            <!-- The right margin keeps the code column clear of the overlay scrollbar. -->
            <Grid ColumnDefinitions="56,*,Auto" ToolTip.Tip="{Binding ToolTip}" Background="Transparent" Margin="0,0,10,0">
              <TextBlock Grid.Column="0" Classes="secondary agentClock" FontSize="11" Text="{Binding TimeText}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock FontSize="11" Text="{Binding Tool}" />
                <TextBlock Classes="secondary" FontSize="11" Text="{Binding Agent}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="secondary agentClock" FontSize="11" Text="{Binding DurationText}" />
                <TextBlock FontSize="11" Text="{Binding Code}" Classes.danger="{Binding IsError}" Classes.secondary="{Binding !IsError}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
